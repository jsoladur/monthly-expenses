# ============================================================================
# Monthly Expenses — environment template.
#
# Two scenarios:
#
#   1. Local dev with `docker compose up`: copy this file to `.env` and fill
#      in the real values. Compose reads `.env` and wires both services on
#      the `expenses-net` bridge network.
#
#   2. Standalone image (Docker Hub, remote server, k8s, etc.): pass the same
#      keys via `-e` flags, `--env-file`, or your platform's secret store.
#      DATABASE_URL points at any reachable Postgres 16 — the bundled compose
#      `db` service is optional. See the README's "Docker Hub deployment"
#      section for the full `docker run` command.
#
# Never commit a real `.env`.
# ============================================================================

# ---- App --------------------------------------------------------------------
# Public URL of the deployed app. Used for Auth.js callbacks and the PWA
# start URL. Set to the URL end-users type in their browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js v5 base URL. Drives the OAuth callback URL the providers endpoint
# returns. Set this to the same public URL the browser uses so Google
# redirects work when the app sits behind a reverse proxy. When unset,
# Auth.js falls back to `trustHost` (the request's Host / X-Forwarded-Host),
# which works for direct access but breaks behind most reverse proxies.
AUTH_URL=http://localhost:3000

# ---- Auth.js (ARCH §3.2) ----------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=
# Google OAuth web client. Create at https://console.cloud.google.com/.
# The Authorized redirect URI must include:
#   ${AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated email allowlist. Trim + lowercase is applied before check
# (PRD C2 / §5.2). A non-allowlisted Google sign-in gets HTTP 403 and zero
# database rows.
ALLOWED_EMAILS=

# ---- Database ---------------------------------------------------------------
# Postgres connection string. Used by the app at runtime AND by drizzle-kit
# for local migrations. Defaults to the bundled compose service name `db`;
# point at any reachable Postgres 16 for a standalone deployment.
DATABASE_URL=postgres://expenses:expenses@db:5432/expenses

# Only used by the local `db` service in `docker-compose.yml`. Ignored when
# running the standalone image against an external database.
POSTGRES_DB=expenses
POSTGRES_USER=expenses
DB_PASSWORD=expenses
